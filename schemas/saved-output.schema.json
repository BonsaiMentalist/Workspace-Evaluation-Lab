{
  "$id": "eval-lab/saved-output.schema.json",
  "title": "saved-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "eval-lab/saved-output"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text": {
      "default": "",
      "type": "string",
      "maxLength": 200000
    },
    "toolArtifacts": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 300
              },
              "model": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "text"
            ]
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 50000
          },
          "attachment": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "store": {
                    "type": "string",
                    "enum": [
                      "fixture",
                      "local"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,99}\\.(png|jpg|webp)$"
                  },
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5242880
                  },
                  "alt": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "store",
                  "name",
                  "mediaType",
                  "bytes"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "tool",
          "kind"
        ]
      }
    },
    "producedBy": {
      "default": {
        "model": null,
        "provider": null,
        "effort": null,
        "modelVersion": null
      },
      "type": "object",
      "properties": {
        "model": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "modelVersion": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "configuration": {
      "default": {
        "configurationId": null,
        "fingerprint": null,
        "contextConfigId": null,
        "toolConfigIds": []
      },
      "type": "object",
      "properties": {
        "configurationId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "contextConfigId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "toolConfigIds": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "workspace": {
      "default": {
        "job": null,
        "piece": null,
        "phase": null,
        "reply": null,
        "chat": null
      },
      "type": "object",
      "properties": {
        "job": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "piece": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "worker",
                "review",
                "master-check"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reply": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "chat": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resources": {
      "default": {
        "tokens": null,
        "durationS": null,
        "steps": null,
        "provenance": {
          "source": "unknown",
          "note": ""
        }
      },
      "type": "object",
      "properties": {
        "tokens": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "uncached": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheWrite": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheWrite1h": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheRead": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "thinking": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "durationS": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "default": {
            "source": "unknown",
            "note": ""
          },
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "unknown",
                "manual-entry",
                "workspace-analytics",
                "runner-report",
                "synthetic"
              ]
            },
            "note": {
              "default": "",
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "source"
          ]
        }
      }
    },
    "producedAt": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "synthetic",
            "user"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "synthetic-suite",
            "manual-entry",
            "file-import",
            "observation",
            "runner-import"
          ]
        },
        "sourceFile": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 260
            },
            {
              "type": "null"
            }
          ]
        },
        "importedAt": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "origin",
        "source"
      ]
    },
    "privacy": {
      "type": "string",
      "enum": [
        "synthetic",
        "local-private",
        "shareable"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "id",
    "caseId",
    "caseVersion",
    "label",
    "provenance",
    "privacy",
    "createdAt"
  ]
}
