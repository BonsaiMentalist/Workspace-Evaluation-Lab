{
  "$id": "eval-lab/workspace-join-keys.schema.json",
  "title": "workspace-join-keys",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "piece": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "worker",
            "review",
            "master-check"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reply": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "chat": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
