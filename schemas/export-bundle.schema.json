{
  "$id": "eval-lab/export-bundle.schema.json",
  "title": "export-bundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "eval-lab/export-bundle"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "profiles": {
      "default": [],
      "maxItems": 5000,
      "type": "array",
      "items": {}
    },
    "cases": {
      "default": [],
      "maxItems": 20000,
      "type": "array",
      "items": {}
    },
    "outputs": {
      "default": [],
      "maxItems": 50000,
      "type": "array",
      "items": {}
    },
    "results": {
      "default": [],
      "maxItems": 100000,
      "type": "array",
      "items": {}
    },
    "comparisons": {
      "default": [],
      "maxItems": 50000,
      "type": "array",
      "items": {}
    },
    "observations": {
      "default": [],
      "maxItems": 50000,
      "type": "array",
      "items": {}
    },
    "importBatches": {
      "default": [],
      "maxItems": 5000,
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "exportedAt",
    "app"
  ]
}
