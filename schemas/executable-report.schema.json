{
  "$id": "eval-lab/executable-report.schema.json",
  "title": "executable-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "eval-lab/executable-report"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "version": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ranAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "outputId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "tests": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "error"
            ]
          },
          "durationMs": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
    },
    "criterionMapping": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "testNamePrefix": {
            "default": "",
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "criterionId"
        ]
      }
    },
    "baseline": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "maxLength": 300
            },
            "label": {
              "default": "",
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "runId"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "knownFailures": {
      "default": [],
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "runner",
    "ranAt",
    "caseId",
    "caseVersion",
    "outputId",
    "tests",
    "criterionMapping"
  ]
}
